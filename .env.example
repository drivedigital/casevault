# ============================================================================
# CaseVault / Legal Matter Intelligence — environment template
# Copy to `.env.local` (git-ignored) and fill in real values.
# Process environment always takes precedence over file values.
# ============================================================================

# --- Core app ---------------------------------------------------------------
APP_ENV=development
APP_PORT_WEB=3000
APP_PORT_API=8000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Leave DATABASE_URL EMPTY to fall back to ./data/dev.sqlite (native dev/tests,
# no Docker required — WS-CLAIMS bootstrap). Point at Postgres once
# `docker compose up -d` is running:
DATABASE_URL=
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casevault
REDIS_URL=redis://localhost:6379/0
LOCAL_STORAGE_ROOT=./data
APP_SECRET_KEY=
SESSION_SECRET=

# --- Workspace defaults (apps/api bootstrap) ---------------------------------
DEFAULT_WORKSPACE_SLUG=default
DEFAULT_WORKSPACE_NAME=Default Workspace

# --- AI providers (WS-AI-INTEL) ----------------------------------------------
# Provider selection / guardrails
#   AI_DEFAULT_PROVIDER   preferred provider name when a job does not name one
#   AI_SHARING_POLICY     no_ai | local_only | external_excerpts_only |
#                         external_selected_full_docs
#   AI_DISABLED_PROVIDERS comma-separated provider names to force off
#   AI_ENV_FILE           alternate dotenv file (default: ./.env.local)
AI_DEFAULT_PROVIDER=
AI_SHARING_POLICY=external_excerpts_only
AI_DISABLED_PROVIDERS=
AI_ENV_FILE=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=https://api.antropic.com

# NVIDIA NIM (OpenAI-compatible endpoint)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Ollama — local server or Ollama Cloud endpoint
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1

# Optional providers (Technical Spec §6.1)
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# --- Search / embeddings (later waves) ---------------------------------------
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# --- MCP connectors -----------------------------------------------------------
MCP_DEFAULT_TIMEOUT=30
