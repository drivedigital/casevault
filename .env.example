# ==========================================================================
# CaseVault — environment template
# Copy to .env.local and fill in values. .env.local is git-ignored.
# NEVER commit a real .env file. NEVER put evidence paths in Git.
# ==========================================================================

# --- app ---
# API defaults to 8100 to avoid conflicts with common local LLM tooling on
# the dev machine: oMLX uses 8000, LiteLLM uses 4000/8080, Ollama 11434.
APP_ENV=development
APP_PORT_WEB=3000
APP_PORT_API=8100
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8100

# --- database / queue ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casevault
REDIS_URL=redis://localhost:6379/0

# --- file storage (local-first; git-ignored) ---
STORAGE_MODE=local
LOCAL_STORAGE_ROOT=./data

# --- security (local dev values are fine; rotate for anything shared) ---
APP_SECRET_KEY=change-me-local-only
SESSION_SECRET=change-me-local-only

# --- AI providers (optional at Phase 0; leave blank to keep AI disabled) ---
# Effective default AI-sharing policy is `no_ai` until explicitly configured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- search / embeddings (configured in a later phase) ---
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# --- OCR / parsing ---
OCR_ENGINE=tesseract
# TESSERACT_PATH=

# --- MCP connectors (configured in a later phase) ---
MCP_DEFAULT_TIMEOUT=30
