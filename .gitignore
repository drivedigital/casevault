# >>> Phase 0 plan — legal-data protections (docs/specs/..._Repo_Scaffold_Phase0_Plan.md §5)
# IMPORTANT: data/ holds sensitive local evidence. It must NEVER be committed.

# env / secrets
.env
.env.*
!.env.example

# node / frontend
node_modules/
.next/
out/
coverage/

# python
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
*.pyc

# local data / evidence / derived artifacts
data/
uploads/
evidence/
exports/
logs/
tmp/
cache/

# db files if local sqlite ever used
*.sqlite
*.sqlite3
*.db

# misc
.DS_Store
.vscode/
.idea/
